{
  "id": "channel-ask-user",
  "name": "Ask User For",
  "version": "1.0.0",
  "type": "channel",
  "description": "Unified user interaction: choice, text, document, artifact, file, and chat modes.",
  "tools": [
    {
      "name": "channel-ask-user.askUserFor",
      "description": "Ask the user for input in a specific mode. Modes: choice (pick from list), text (freeform short answer), document (provide/draft a document), artifact (select existing artifact), file (pick repo file), chat (spawn Yuan conversation).",
      "parameters": {
        "type": "object",
        "properties": {
          "prompt": { "type": "string", "description": "What to ask the user" },
          "mode": { "type": "string", "enum": ["choice", "text", "document", "artifact", "file", "chat"], "description": "Interaction mode" },
          "options": {
            "type": "object",
            "properties": {
              "choices": { "type": "array", "items": { "type": "string" }, "description": "Options for choice mode" },
              "documentType": { "type": "string", "description": "Type hint for document mode" },
              "template": { "type": "string", "description": "Starter content for document mode" },
              "chatStyle": { "type": "string", "enum": ["explorer", "analyst", "worker"], "description": "Yuan persona for chat mode" },
              "successCriteria": { "type": "string", "description": "When the chat is complete" },
              "timeout": { "type": "number", "description": "Timeout in ms (default 300000)" }
            }
          }
        },
        "required": ["prompt", "mode"]
      }
    }
  ],
  "sandboxBindings": {
    "askUserFor": "channel-ask-user.askUserFor"
  },
  "permissions": []
}
